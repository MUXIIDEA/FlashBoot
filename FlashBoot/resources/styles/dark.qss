QMainWindow {
    background-color: #202020;
}

QWidget {
    color: #FFFFFF;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 9pt;
}

QGroupBox {
    border: 1px solid #424242;
    border-radius: 6px;
    margin-top: 6px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px 0 4px;
    font-weight: bold;
    font-size: 11pt;
    color: #FFFFFF;
}

QPushButton {
    background-color: #4CC2FF;
    color: #1A1A1A;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #47B5F0;
}

QPushButton:pressed {
    background-color: #3DA8E0;
}

QPushButton:disabled {
    background-color: #424242;
    color: #A0A0A0;
}

QLineEdit {
    border: 1px solid #424242;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #2D2D2D;
    color: #FFFFFF;
}

QLineEdit:focus {
    border-color: #4CC2FF;
    outline: none;
}

QComboBox {
    border: 1px solid #424242;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #2D2D2D;
    color: #FFFFFF;
    min-width: 150px;
}

QComboBox:focus {
    border-color: #4CC2FF;
    outline: none;
}

QComboBox::drop-down {
    border-left: 1px solid #424242;
    border-radius: 0 4px 4px 0;
}

QComboBox::down-arrow {
    image: url(:/icons/arrow_down.png);
}

QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 2px solid #424242;
    background-color: #2D2D2D;
}

QCheckBox::indicator:checked {
    background-color: #4CC2FF;
    border-color: #4CC2FF;
}

QListWidget {
    border: 1px solid #424242;
    border-radius: 4px;
    background-color: #2D2D2D;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #323232;
}

QListWidget::item:hover {
    background-color: #323232;
}

QListWidget::item:selected {
    background-color: #1E3A5F;
    border-left: 3px solid #4CC2FF;
}

QProgressBar {
    border: 1px solid #424242;
    border-radius: 4px;
    text-align: center;
    height: 20px;
    background-color: #3C3C3C;
}

QProgressBar::chunk {
    background-color: #4CC2FF;
    border-radius: 4px;
}

QPlainTextEdit {
    border: 1px solid #424242;
    border-radius: 4px;
    font-family: Consolas, monospace;
    font-size: 9pt;
    background-color: #1E1E1E;
    color: #D4D4D4;
}

QStatusBar {
    background-color: #202020;
    border-top: 1px solid #424242;
}

QLabel {
    color: #A0A0A0;
}

QLabel[text="warning"] {
    color: #FFC107;
}

QLabel[text="error"] {
    color: #FF5252;
}

QLabel[text="success"] {
    color: #54B054;
}